rules_version = '2';

// Règles Cloud Storage AeroTrace.
// - firmware/atv/** : PUBLIC en lecture (OTA cloud-pull de l'écran AT-VIEW, sans token ;
//   le binaire n'est pas secret — cf MITM déjà non couvert par setInsecure côté boîtier).
// - tout le reste (flights, firmware/{wrover,s3}, ...) : lecture/écriture si authentifié
//   (provider Anonyme — upload vol, OTA boîtier avec Bearer token).
service firebase.storage {
  match /b/{bucket}/o {
    match /firmware/atv/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
