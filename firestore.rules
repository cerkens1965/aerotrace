rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Lit le rôle plateforme depuis /users/{uid}
    // Valeurs attendues : 'user' | 'instructor' | 'admin' | 'super_admin'
    function userRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data == null ? 'user' : userDoc.data.get('role', 'user');
    }

    function isSuperAdmin() {
      return isSignedIn() && userRole() == 'super_admin';
    }

    // admin (club admin) inclut super_admin (super_admin = admin transitif)
    function isAdmin() {
      return isSignedIn() && userRole() in ['admin', 'super_admin'];
    }

    function isInstructorOrAdmin() {
      return isSignedIn() && userRole() in ['instructor', 'admin', 'super_admin'];
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    // Lecture : soi-même ou admin. Création : soi-même (first login dans App.jsx).
    // Update : soi-même (profil) ou admin (promotion rôle).
    match /users/{uid} {
      allow read:   if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // (allowlist) Le provisioning (rôle/club) est fait CÔTÉ SERVEUR par la
      // Cloud Function claimAccess (admin SDK, bypass des règles) — plus de
      // self-create côté client. Un admin peut créer/éditer un membre.
      allow create: if isAdmin();
      // Self-update : uniquement des champs de PROFIL (jamais role ni clubId).
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == uid
                        && request.resource.data.get('role','user') == resource.data.get('role','user')
                        && request.resource.data.get('clubId','')   == resource.data.get('clubId',''));
      allow delete: if false;
    }

    // ── Invites (allowlist « personnes désignées ») ──────────────────────────────
    // doc id = email (minuscule). Créés/gérés par un admin ; lus/consommés par la
    // Cloud Function claimAccess (admin SDK). Aucun accès client direct nécessaire.
    match /invites/{email} {
      allow read, write: if isAdmin();
    }

    // ── Clubs ──────────────────────────────────────────────────────────────────
    // Création/édition réservée à super_admin (gouvernance plateforme cross-club).
    // Read pour tout user authentifié (les admins de club doivent voir leur club).
    match /clubs/{clubId} {
      allow read:  if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Aircraft ───────────────────────────────────────────────────────────────
    match /aircraft/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Pilots ─────────────────────────────────────────────────────────────────
    match /pilots/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── FDR status ─────────────────────────────────────────────────────────────
    // L'ESP32 (LILYGO T-SIM7600G-H) écrit via Firestore REST API sans Firebase Auth.
    // Write reste ouvert jusqu'à l'implémentation de l'auth hardware (NFC PN532).
    // Read restreint aux utilisateurs connectés.
    match /fdr_status/{icao24} {
      allow read:  if isSignedIn();
      allow write: if true;
    }

    // ── Flights ────────────────────────────────────────────────────────────────
    // Create : tout utilisateur connecté (upload CSV via ReplayPage).
    // Update : instructeur ou admin (assignation pilote/avion, validation).
    // Delete : admin uniquement (purge de vols de test). Une Cloud Function
    //          onFlightDeleted nettoie les CSV Storage associés.
    match /flights/{flightId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isInstructorOrAdmin();
      allow delete: if isAdmin();
    }

    // ── Devices (boîtiers ATC + écran ATV) — état firmware de la flotte ──────────
    // doc id = boxId (MAC court). Écrit par le BOÎTIER pendant ses sessions WiFi
    // (auth anon, comme /flights) → version courante, état OTA, lien callSign.
    // Lu par le dashboard (FleetPage). Un admin peut éditer (lien callSign manuel).
    match /devices/{boxId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
