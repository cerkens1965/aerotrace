{
  "name": "aerotrace-functions",
  "description": "Firebase Cloud Functions for Aerotrace",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "node test/attribution.js",
    "emulators": "cd .. && firebase emulators:start --only firestore,functions,auth",
    "test:coownership": "node test/coownership.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.0",
    "node-fetch": "^3.3.2"
  }
}
